  { "name": "cfb-lab", "paths": ["football/cfb_lab/**", "football/cfb_production/**", "football/cfb_decision/**", "football/cfb_market/**", "lib/cfb_champion.js", "lib/cfb_disagreement.js", "lib/cfb_reliability.js"] },
  { "name": "nfl-model", "paths": ["football/nfl/**", "football/engine.js", "football/params.js"] },
