{
 "_doc": "Subsystems for the session lock (tools/integrity/lock.js). Two open pull requests may not change the same subsystem; the older one holds it until it merges or closes. A path that matches no subsystem is locked file by file; a hotspot (a shared file too large to lock whole) is locked by the lines it changes. Generated files (tools/integrity/ownership.js) and changelog.d/ fragments are never locked. Add a subsystem when two areas turn out to break each other; keep its tests in it. Every glob must match a tracked file (integrity.test.js checks).",
 "hotspots": ["app.html", "index.html", "package.json", "README.md", "methodology/index.html", "CHANGELOG.md"],
 "hotspot_margin_lines": 20,
 "stale_after_hours": 72,
 "subsystems": [
  { "name": "pipeline", "paths": ["tools/integrity/**", "tools/changelog/**", "tools/ci/**", "CLAUDE.md", "AGENTS.md", "docs/engineering/**", ".github/workflows/integrity-*.yml", ".github/workflows/changelog.yml"] },
