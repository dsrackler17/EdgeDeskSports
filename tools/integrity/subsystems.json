  { "name": "ufc", "paths": ["tools/ufc/**"] },
  { "name": "games", "paths": ["games/**", "tools/games/**", "tools/slate/**", "lib/edgedesk_games.js", "lib/edgedesk_games_ui.js", "lib/edgedesk_games.css"] },
