# =============================================================================
# EdgeDesk — environment variables, by NAME ONLY. Never commit a value.
#
# WHERE EACH ONE LIVES
#   Edge function secrets: Supabase dashboard → Edge Functions → Secrets
#                          (or `supabase secrets set NAME=...`)
#   GitHub Actions:        Settings → Secrets and variables → Actions
#   Local test runs:       nothing — every suite in this repository runs
#                          offline against fixtures and needs no key.
# =============================================================================

# ---- supabase/functions/edgedesk_ai (the research desk) ---------------------
ANTHROPIC_API_KEY=                 # the writing model. Absent: ?dry=1 still works; POST answers 503
SUPABASE_URL=                      # injected by Supabase on deploy
SUPABASE_ANON_KEY=                 # injected by Supabase on deploy; every read runs under the caller's JWT
EDGEDESK_AI_MODEL=                 # optional; default claude-sonnet-5
EDGEDESK_AI_RESEARCH=1             # 0 = packet-only narration (no retrieval)
EDGEDESK_DECISIONS_ENABLED=1       # 0 = the decision layer is off; answers say so
EDGEDESK_STRUCTURED_ANSWER=1       # 0 = the four-section Desk read without the research packet, the label or the critic
EDGEDESK_TOOL_LOOP=0               # 1 = the model may call the research kernel's tools (bounded); verified against a stub only
EDGEDESK_TOOL_LOOP_ROUNDS=4        # max model round trips when the tool loop is on (1-6)
EDGEDESK_TOOL_BUDGET=8             # max tool calls per request (1-16)
EDGEDESK_SITE_BASE=https://edgedesksports.com   # where the published artifacts are read from
EDGEDESK_REAL_FLOOR=0.005          # EV floor; must track the browser engine's REAL_FLOOR
EDGEDESK_EDGE_MAX_AGE_MIN=90       # quote freshness fallback (the kickoff ladder overrides it)
EDGEDESK_EVIDENCE_MAX=240000       # evidence characters per message
EDGEDESK_MIN_PATTERN_N=30          # minimum samples before a learned pattern may be quoted
EDGEDESK_MLB_FALLBACK=1            # MLB Stats API fallback when owned tables are empty
CFBD_API_KEY=                      # optional; enables the CollegeFootballData adapters
EDGEDESK_NFLVERSE=0                # optional; with EDGEDESK_NFLVERSE_BASE enables the nflverse adapter
EDGEDESK_NFLVERSE_BASE=
EDGEDESK_CBB_RATINGS_URL=

# ---- supabase/functions/capture, close, learn -------------------------------
ODDS_API_KEY=                      # The Odds API (capture)
CRON_SECRET=                       # shared secret the scheduled callers present
CAPTURE_CRON_SECRET=               # the capture backup workflow's secret

# ---- GitHub Actions (names used by .github/workflows) -----------------------
SB_URL=                            # the Supabase project URL
SB_SERVICE_ROLE=                   # service role, for ingestion jobs only; never shipped to a browser
SUPABASE_ACCESS_TOKEN=             # deploy-intelligence.yml: deploys functions
SUPABASE_PROJECT_REF=              # deploy-intelligence.yml
SB_DB_URL=                         # deploy-intelligence.yml: applies SQL migrations
RESEND_API_KEY=                    # newsletter
COLLECTIVE_ADMIN_REFRESH_TOKEN=    # collective admin jobs
