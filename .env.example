# =============================================================================
# EdgeDesk — environment variables, by NAME ONLY. Never commit a value.
#
# WHERE EACH ONE LIVES
#   Edge function secrets: Supabase dashboard → Edge Functions → Secrets
#                          (or `supabase secrets set NAME=...`)
#   GitHub Actions:        Settings → Secrets and variables → Actions
#   Local test runs:       nothing — every suite in this repository runs
#                          offline against fixtures and needs no key.
# =============================================================================

# ---- supabase/functions/edgedesk_ai (the research desk) ---------------------
ANTHROPIC_API_KEY=                 # the writing model. Absent: ?dry=1 still works; POST answers 503
SUPABASE_URL=                      # injected by Supabase on deploy
SUPABASE_ANON_KEY=                 # injected by Supabase on deploy; every read runs under the caller's JWT
EDGEDESK_AI_MODEL=                 # optional; default claude-sonnet-5
EDGEDESK_AI_RESEARCH=1             # 0 = packet-only narration (no retrieval)
EDGEDESK_DECISIONS_ENABLED=1       # 0 = the decision layer is off; answers say so
EDGEDESK_STRUCTURED_ANSWER=1       # 0 = the four-section Desk read without the research packet, the label or the critic
EDGEDESK_TOOL_LOOP=0               # 1 = the model may call the research kernel's tools (bounded); verified against a stub only
EDGEDESK_TOOL_LOOP_ROUNDS=4        # max model round trips when the tool loop is on (1-6)
# ── Slice 3: the analyst layer and the active research loop ──────────────────
EDGEDESK_ANALYST=1                 # 0 = no interactions, form, sensitivity, scenarios or follow-up state (the r13 answer)
EDGEDESK_PRICING=1                 # 0 = no fair line, bet-to, status or ranked board (the r14 answer); reads football/validation/pricing_<sport>.json
EDGEDESK_INVESTIGATE=1             # 0 = the bounded investigation loop never runs; nothing beyond the artifacts is checked
EDGEDESK_INVESTIGATE_MS=2500       # time budget per turn for provider calls (500-8000)
EDGEDESK_INVESTIGATE_REQUESTS=4    # request budget per turn (1-8)
EDGEDESK_INVESTIGATE_SEARCH_CALLS=2  # paid search calls per turn (0-4)
EDGEDESK_SEARCH_API_KEY=           # Brave Search API subscription token; unset = the web_search provider reports BLOCKED and names this var
EDGEDESK_SEARCH_API_BASE=https://api.search.brave.com/res/v1/web/search
EDGEDESK_NFLVERSE_RELEASES=https://github.com/nflverse/nflverse-data/releases/download   # the live injury report (public, keyless)
EDGEDESK_OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast                          # the live kickoff forecast (public, keyless)
EDGEDESK_TOOL_BUDGET=8             # max tool calls per request (1-16)
# ── Slice 7: the board (card-wide questions across every supported sport) ────
EDGEDESK_BOARD=1                   # 0 = no board sweep; a best-bets question falls back to the single-signal focus (the pre-Slice-7 answer)
EDGEDESK_DEFAULT_TIMEZONE=America/New_York   # used only when the browser sends no valid IANA zone; the answer says so
EDGEDESK_BOARD_SPORTS=             # optional comma list to restrict the sweep (default: every supported sport in season)
EDGEDESK_QUOTE_REFRESH=0           # 1 = a board with a STALE/AGING captured price asks the capture function for one pass (spends odds-API credits), then re-reads; needs CRON_SECRET below on THIS function
EDGEDESK_QUOTE_REFRESH_GAP_MIN=10  # at most one refresh per sport per gap (1-120)
EDGEDESK_QUOTE_REFRESH_TIMEOUT_MS=6000   # the refresh call is abandoned (and reported TIMED_OUT) past this
EDGEDESK_SITE_BASE=https://edgedesksports.com   # where the published artifacts are read from
EDGEDESK_REAL_FLOOR=0.005          # EV floor; must track the browser engine's REAL_FLOOR
EDGEDESK_EDGE_MAX_AGE_MIN=90       # quote freshness fallback (the kickoff ladder overrides it)
EDGEDESK_EVIDENCE_MAX=240000       # evidence characters per message
EDGEDESK_MIN_PATTERN_N=30          # minimum samples before a learned pattern may be quoted
EDGEDESK_MLB_FALLBACK=1            # MLB Stats API fallback when owned tables are empty
CFBD_API_KEY=                      # optional; enables the CollegeFootballData adapters
EDGEDESK_NFLVERSE=0                # optional; with EDGEDESK_NFLVERSE_BASE enables the nflverse adapter
EDGEDESK_NFLVERSE_BASE=
EDGEDESK_CBB_RATINGS_URL=

# ---- supabase/functions/capture, close, learn -------------------------------
ODDS_API_KEY=                      # The Odds API (capture)
CRON_SECRET=                       # shared secret the scheduled callers present
CAPTURE_CRON_SECRET=               # the capture backup workflow's secret

# ---- GitHub Actions (names used by .github/workflows) -----------------------
SB_URL=                            # the Supabase project URL
SB_SERVICE_ROLE=                   # service role, for ingestion jobs only; never shipped to a browser
SUPABASE_ACCESS_TOKEN=             # deploy-intelligence.yml: deploys functions
SUPABASE_PROJECT_REF=              # deploy-intelligence.yml
SB_DB_URL=                         # deploy-intelligence.yml: applies SQL migrations
RESEND_API_KEY=                    # newsletter
COLLECTIVE_ADMIN_REFRESH_TOKEN=    # collective admin jobs
# ── Slice 6: the nightly learning loop (GitHub Actions secrets; never in the browser) ─────
SUPABASE_SERVICE_ROLE_KEY=         # lets tools/intelligence/learning_loop.js read research_packet_pricing (the workflow maps the repository's SB_URL / SB_SERVICE_ROLE secrets to these); unset = the scorecard reads NO_DATABASE_ACCESS

# ---- TENNIS RESEARCH RECORD -------------------------------------------------
# The tennis record jobs (import, features, ratings, model, board, settlement)
# are the only ones in this repository that need a DIRECT database connection
# rather than PostgREST: they are set-based SQL over hundreds of thousands of
# rows, and a REST round trip per row is neither fast enough nor kind enough to
# the API. See tools/tennis/lib/pg.js for why, and docs/tennis-architecture.md
# for how. None of these ever reaches a browser or an Edge Function.
SUPABASE_DB_URL=                   # Supabase > Connect > Session pooler. Used by tools/tennis/* only.
                                   # In GitHub Actions this is NOT a new secret: tennis-record.yml
                                   # passes the repository's existing SB_DB_URL under this name.
DATABASE_URL=                      # accepted as the same thing, under the name most tooling uses
EDGD_PG=                           # psql-style args instead of a URL, e.g. "-h 127.0.0.1 -p 5432 -U postgres" (local and CI)

# The licensed tennis feed that will one day replace the CC BY-NC-SA research
# archive. Unset today, and nothing is blocked by that: the adapter is isolated
# in tools/tennis/providers/licensed_feed.js and the whole system runs on the
# research archive until these exist. Setting them is step 2 of three — step 1
# is registering the source in tennis.source_licenses with commercial_use=true
# and a named clearer, which the database refuses to let you skip.
TENNIS_FEED_API_KEY=
TENNIS_FEED_BASE_URL=

# Open-Meteo's FREE tier is non-commercial. A commercial plan issues a key, and
# the same licence gate applies: no weather reaches a paid surface until the
# source row says it may.
OPEN_METEO_API_KEY=
