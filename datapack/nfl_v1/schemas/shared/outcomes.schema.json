{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shared.outcomes",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Canonical record ID; do not use display names as keys.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "description": "UTC ingestion time; never backdate this to event time.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Monotone version of this source record.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "quality_status": {
      "type": "string",
      "description": "observed, estimated, missing, conflict, quarantined or restricted.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "market_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Market id.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "selection_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Selection id.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "settlement_result": {
      "type": [
        "string",
        "null"
      ],
      "description": "Settlement result.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "settlement_rule": {
      "type": [
        "string",
        "null"
      ],
      "description": "Settlement rule.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "observed_value": {
      "type": [
        "number",
        "null"
      ],
      "description": "Observed value.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "payout_multiplier": {
      "type": [
        "number",
        "null"
      ],
      "description": "Payout multiplier.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "stake_returned_fraction": {
      "type": [
        "number",
        "null"
      ],
      "description": "Stake returned fraction.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "profit_per_unit": {
      "type": [
        "number",
        "null"
      ],
      "description": "Profit per unit.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "settled_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Settled at.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "void": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Void.",
      "x-unit": "boolean",
      "x-priority": "P0"
    },
    "dead_heat": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Dead heat.",
      "x-unit": "boolean",
      "x-priority": "P0"
    },
    "settlement_evidence_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Settlement evidence url.",
      "x-unit": "text",
      "x-priority": "P0"
    }
  },
  "required": [
    "record_id",
    "source_id",
    "retrieved_at",
    "revision",
    "quality_status"
  ],
  "additionalProperties": false
}