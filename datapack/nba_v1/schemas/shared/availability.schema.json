{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shared.availability",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Canonical record ID; do not use display names as keys.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "description": "UTC ingestion time; never backdate this to event time.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Monotone version of this source record.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "quality_status": {
      "type": "string",
      "description": "observed, estimated, missing, conflict, quarantined or restricted.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "player_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Player id.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "team_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Team id.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Status.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "injury_body_part": {
      "type": [
        "string",
        "null"
      ],
      "description": "Injury body part.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "report_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Report type.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "role": {
      "type": [
        "string",
        "null"
      ],
      "description": "Role.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "replacement_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Replacement id.",
      "x-unit": "category",
      "x-priority": "P0"
    },
    "reported_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reported at.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Expires at.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "participation_probability": {
      "type": [
        "number",
        "null"
      ],
      "description": "Participation probability.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "expected_minutes": {
      "type": [
        "number",
        "null"
      ],
      "description": "Expected minutes.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "expected_snaps": {
      "type": [
        "number",
        "null"
      ],
      "description": "Expected snaps.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "expected_usage": {
      "type": [
        "number",
        "null"
      ],
      "description": "Expected usage.",
      "x-unit": "number",
      "x-priority": "P0"
    },
    "confirmed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Confirmed.",
      "x-unit": "boolean",
      "x-priority": "P0"
    },
    "evidence_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "Evidence url.",
      "x-unit": "text",
      "x-priority": "P0"
    }
  },
  "required": [
    "record_id",
    "source_id",
    "retrieved_at",
    "revision",
    "quality_status"
  ],
  "additionalProperties": false
}