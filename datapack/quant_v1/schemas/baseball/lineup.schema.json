      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
