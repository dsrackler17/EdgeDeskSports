      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "wicket": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Wicket.",
      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "wide": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Wide.",
      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "no_ball": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "No ball.",
      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "ball_speed": {
      "type": [
        "number",
        "null"
      ],
