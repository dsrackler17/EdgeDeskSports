{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mma.fighter_context",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Canonical record ID; do not use display names as keys.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "description": "UTC ingestion time; never backdate this to event time.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Monotone version of this source record.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "quality_status": {
      "type": "string",
      "description": "observed, estimated, missing, conflict, quarantined or restricted.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "height": {
      "type": [
        "number",
        "null"
      ],
      "description": "Height.",
      "x-unit": "inches",
      "x-priority": "P1"
    },
    "reach": {
      "type": [
        "number",
        "null"
      ],
      "description": "Reach.",
      "x-unit": "inches",
      "x-priority": "P1"
    },
    "weigh_in_weight": {
      "type": [
        "number",
        "null"
      ],
      "description": "Weigh in weight.",
      "x-unit": "pounds",
      "x-priority": "P1"
    },
    "age_years": {
      "type": [
        "number",
        "null"
      ],
      "description": "Age years.",
      "x-unit": "number",
      "x-priority": "P1"
    },
    "stance": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stance.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "camp": {
      "type": [
        "string",
        "null"
      ],
      "description": "Camp.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "weight_class": {
      "type": [
        "string",
        "null"
      ],
      "description": "Weight class.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "medical_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Medical status.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "days_since_last_bout": {
      "type": [
        "number",
        "null"
      ],
      "description": "Days since last bout.",
      "x-unit": "days",
      "x-priority": "P1"
    },
    "notice_days": {
      "type": [
        "number",
        "null"
      ],
      "description": "Notice days.",
      "x-unit": "days",
      "x-priority": "P1"
    },
    "career_wins": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Career wins.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "career_losses": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Career losses.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "career_draws": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Career draws.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "prior_ko_losses": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Prior ko losses.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "weight_misses": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Weight misses.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "weight_missed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Weight missed.",
      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "weight_class_change": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Weight class change.",
      "x-unit": "boolean",
      "x-priority": "P1"
    },
    "camp_change": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Camp change.",
      "x-unit": "boolean",
      "x-priority": "P1"
    }
  },
  "required": [
    "record_id",
    "source_id",
    "retrieved_at",
    "revision",
    "quality_status"
  ],
  "additionalProperties": false
}