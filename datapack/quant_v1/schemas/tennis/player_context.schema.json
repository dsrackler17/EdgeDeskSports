{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tennis.player_context",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Canonical record ID; do not use display names as keys.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "description": "UTC ingestion time; never backdate this to event time.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Monotone version of this source record.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "quality_status": {
      "type": "string",
      "description": "observed, estimated, missing, conflict, quarantined or restricted.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Rank.",
      "x-unit": "rank",
      "x-priority": "P1"
    },
    "ranking_points": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Ranking points.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "matches_last_7_days": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Matches last 7 days.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "matches_last_14_days": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Matches last 14 days.",
      "x-unit": "count",
      "x-priority": "P1"
    },
    "court_time_last_7_days_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Court time last 7 days seconds.",
      "x-unit": "seconds",
      "x-priority": "P1"
    },
    "days_rest": {
      "type": [
        "number",
        "null"
      ],
      "description": "Days rest.",
      "x-unit": "days",
      "x-priority": "P1"
    },
    "surface_elo": {
      "type": [
        "number",
        "null"
      ],
      "description": "Surface elo.",
      "x-unit": "number",
      "x-priority": "P1"
    },
    "overall_elo": {
      "type": [
        "number",
        "null"
      ],
      "description": "Overall elo.",
      "x-unit": "number",
      "x-priority": "P1"
    },
    "age_years": {
      "type": [
        "number",
        "null"
      ],
      "description": "Age years.",
      "x-unit": "number",
      "x-priority": "P1"
    },
    "handedness": {
      "type": [
        "string",
        "null"
      ],
      "description": "Handedness.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "injury_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Injury status.",
      "x-unit": "category",
      "x-priority": "P1"
    },
    "altitude": {
      "type": [
        "number",
        "null"
      ],
      "description": "Altitude.",
      "x-unit": "meters",
      "x-priority": "P1"
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "description": "Temperature.",
      "x-unit": "celsius",
      "x-priority": "P1"
    },
    "humidity": {
      "type": [
        "number",
        "null"
      ],
      "description": "Humidity.",
      "x-unit": "percent",
      "x-priority": "P1"
    }
  },
  "required": [
    "record_id",
    "source_id",
    "retrieved_at",
    "revision",
    "quality_status"
  ],
  "additionalProperties": false
}