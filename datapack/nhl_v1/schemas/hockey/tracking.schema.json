{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hockey.tracking",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Canonical record ID; do not use display names as keys.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical event identifier with provider mapping maintained separately.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical player, team, fighter or lineup identifier appropriate to table grain.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_id": {
      "type": "string",
      "description": "Source registry identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "source_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original provider record identifier.",
      "x-unit": "identifier",
      "x-priority": "P0"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the event or measurement occurred in UTC; not when it became available.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "known_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "First demonstrably available timestamp in UTC; null if historical availability is unknown.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "description": "UTC ingestion time; never backdate this to event time.",
      "x-unit": "UTC",
      "x-priority": "P0",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Monotone version of this source record.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "quality_status": {
      "type": "string",
      "description": "observed, estimated, missing, conflict, quarantined or restricted.",
      "x-unit": "none",
      "x-priority": "P0"
    },
    "controlled_entries": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Controlled entries.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "uncontrolled_entries": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Uncontrolled entries.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "entry_denials": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Entry denials.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "controlled_exits": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Controlled exits.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "failed_exits": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Failed exits.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "slot_passes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Slot passes.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "cross_slot_passes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Cross slot passes.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "forecheck_recoveries": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Forecheck recoveries.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "rush_attempts": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Rush attempts.",
      "x-unit": "count",
      "x-priority": "P2"
    },
    "puck_possession_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Puck possession seconds.",
      "x-unit": "seconds",
      "x-priority": "P2"
    },
    "skating_speed": {
      "type": [
        "number",
        "null"
      ],
      "description": "Skating speed.",
      "x-unit": "feet_per_second",
      "x-priority": "P2"
    },
    "tracking_frame_json": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tracking frame json.",
      "x-unit": "json",
      "x-priority": "P2"
    }
  },
  "required": [
    "record_id",
    "source_id",
    "retrieved_at",
    "revision",
    "quality_status"
  ],
  "additionalProperties": false
}